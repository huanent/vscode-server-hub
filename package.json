{
  "name": "server-hub",
  "displayName": "ServerHub",
  "description": "Manage and connect to ssh mysql server and more..",
  "version": "1.6.10",
  "engines": {
    "vscode": "^1.125.0"
  },
  "license": "MIT",
  "publisher": "huanent",
  "icon": "resources/logo.png",
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "homepage": "https://github.com/huanent/vscode-server-hub.git",
  "repository": {
    "type": "github",
    "url": "https://github.com/huanent/vscode-server-hub"
  },
  "contributes": {
    "configuration": {
      "title": "ServerHub",
      "properties": {
        "server-hub.serverStoragePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Directory used to store server definitions as individual JSON files. Relative paths and paths starting with ~ are resolved from the user home directory. Restart ServerHub after changing this setting."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "server-hub.editor",
        "displayName": "ServerHub",
        "selector": [
          {
            "filenamePattern": "*.server-hub"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "server-hub",
          "title": "ServerHub",
          "icon": "$(server)"
        }
      ]
    },
    "views": {
      "server-hub": [
        {
          "id": "server-hub.servers",
          "name": "ServerHub",
          "icon": "$(server)"
        }
      ]
    },
    "commands": [
      {
        "command": "server-hub.addServer",
        "title": "Add",
        "icon": "$(add)"
      },
      {
        "command": "server-hub.importServers",
        "title": "Import",
        "icon": "$(cloud-download)"
      },
      {
        "command": "server-hub.exportServers",
        "title": "Export",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "server-hub.exportServer",
        "title": "Export",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "server-hub.connectServer",
        "title": "Connect",
        "icon": "$(run-compact)"
      },
      {
        "command": "server-hub.copyHost",
        "title": "Copy Address",
        "icon": "$(copy)"
      },
      {
        "command": "server-hub.editServer",
        "title": "Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "server-hub.renameGroup",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "server-hub.moveGroupUp",
        "title": "Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "server-hub.moveGroupDown",
        "title": "Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "server-hub.moveServerUp",
        "title": "Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "server-hub.moveServerDown",
        "title": "Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "server-hub.deleteServer",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "server-hub.openSftp",
        "title": "Open SFTP",
        "icon": "$(folder)"
      },
      {
        "command": "server-hub.runSshCommand",
        "title": "Run Script",
        "icon": "$(three-bars)"
      },
      {
        "command": "server-hub.searchServers",
        "title": "Search Servers",
        "icon": "$(search)"
      },
      {
        "command": "server-hub.clearServerSearch",
        "title": "Clear Server Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "server-hub.executeMysqlSql",
        "title": "Execute SQL",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "server-hub.executeMysqlSql",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == sql && server-hub.mysqlSqlEditorActive"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "server-hub.executeMysqlSql",
          "when": "editorLangId == sql && server-hub.mysqlSqlEditorActive",
          "group": "navigation@1"
        },
        {
          "command": "server-hub.runSshCommand",
          "when": "activeWebviewPanelId == server-hub.editor && resourceFilename == sshTerminal.server-hub && server-hub.activeSshHasCommands",
          "group": "navigation@1"
        },
        {
          "command": "server-hub.openSftp",
          "when": "activeWebviewPanelId == server-hub.editor && resourceFilename == sshTerminal.server-hub",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "server-hub.clearServerSearch",
          "when": "view == server-hub.servers && server-hub.serverFilterActive",
          "group": "navigation@1"
        },
        {
          "command": "server-hub.searchServers",
          "when": "view == server-hub.servers",
          "group": "navigation@2"
        },
        {
          "command": "server-hub.importServers",
          "when": "view == server-hub.servers",
          "group": "1_transfer@1"
        },
        {
          "command": "server-hub.exportServers",
          "when": "view == server-hub.servers",
          "group": "1_transfer@2"
        },
        {
          "command": "server-hub.addServer",
          "when": "view == server-hub.servers",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "server-hub.addServer",
          "when": "view == server-hub.servers && viewItem =~ /^serverGroup/",
          "group": "1_modification@1"
        },
        {
          "command": "server-hub.renameGroup",
          "when": "view == server-hub.servers && viewItem =~ /^serverGroup/",
          "group": "1_modification@2"
        },
        {
          "command": "server-hub.moveGroupUp",
          "when": "view == server-hub.servers && viewItem =~ /^serverGroup:.*moveUp/",
          "group": "1_modification@3"
        },
        {
          "command": "server-hub.moveGroupDown",
          "when": "view == server-hub.servers && viewItem =~ /^serverGroup:.*moveDown/",
          "group": "1_modification@4"
        },
        {
          "command": "server-hub.connectServer",
          "when": "view == server-hub.servers && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "inline"
        },
        {
          "command": "server-hub.editServer",
          "when": "view == server-hub.servers && !listMultiSelection && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "1_modification"
        },
        {
          "command": "server-hub.runSshCommand",
          "when": "view == server-hub.servers && !listMultiSelection && viewItem =~ /^sshServer:.*hasCommands/",
          "group": "1_modification@1"
        },
        {
          "command": "server-hub.copyHost",
          "when": "view == server-hub.servers && !listMultiSelection && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "1_modification@2"
        },
        {
          "command": "server-hub.exportServer",
          "when": "view == server-hub.servers && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "1_modification@3"
        },
        {
          "command": "server-hub.moveServerUp",
          "when": "view == server-hub.servers && !listMultiSelection && viewItem =~ /^(ssh|mysql|container)Server:.*moveUp/",
          "group": "1_modification@4"
        },
        {
          "command": "server-hub.moveServerDown",
          "when": "view == server-hub.servers && !listMultiSelection && viewItem =~ /^(ssh|mysql|container)Server:.*moveDown/",
          "group": "1_modification@5"
        },
        {
          "command": "server-hub.deleteServer",
          "when": "view == server-hub.servers && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "2_delete"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run compile && npm run compile:webview",
    "compile": "rimraf out && tsc -p ./",
    "compile:webview": "tsc -p webview/tsconfig.json && vite build",
    "package": "vsce package --no-yarn",
    "publish": "vsce publish --no-yarn"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.x",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.9.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "mysql2": "^3.23.0",
    "ssh2": "^1.17.0"
  }
}
